# Database
DATABASE_URL="postgres://app:app@localhost:5432/app_dev"

# Better Auth
BETTER_AUTH_SECRET="change-me-32-chars-minimum-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable the provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP (Mailpit in dev)
SMTP_URL="smtp://localhost:1025"

# Public
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="pt-BR"

# Docker Compose isolation (allows running multiple client projects locally)
COMPOSE_PROJECT_NAME="sass-next-template"
DB_PORT="5432"
APP_PORT="3000"
